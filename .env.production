# Entorno de PRODUCCIÓN — `npm run prod` en http://localhost:3100
# Sin secretos: este archivo SÍ se sube a git.
#
# Es la MISMA app y el MISMO servidor MariaDB, pero otra base de datos y
# otro bucket. Para apuntar a un servidor real, sobrescribe aquí DB_HOST,
# DB_USER y DB_PASSWORD (o pásalos como variables de entorno del sistema).

DB_NAME=annotation_portal_prod
MINIO_BUCKET=images-prod
APP_URL=http://localhost:3100
