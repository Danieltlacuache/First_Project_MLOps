# ─────────────────────────────────────────────────────────────────────
#  Copia este archivo a .env  →  cp .env.example .env
#
#  .env               = infraestructura y credenciales (COMPARTIDO, no se sube a git)
#  .env.development   = qué BD/bucket usa `npm run dev`   (:3000)
#  .env.production    = qué BD/bucket usa `npm run prod`  (:3100)
#
#  Next.js carga automáticamente .env + el .env.<NODE_ENV> que toque.
# ─────────────────────────────────────────────────────────────────────

# --- MariaDB (contenedor docker, expuesto en tu localhost) ------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=app_password_dev
DB_ROOT_PASSWORD=root_password_dev

# --- MinIO (contenedor docker, expuesto en tu localhost) --------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
